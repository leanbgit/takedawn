+/* The GPU's progress, as the title sees it (the toolkit roadmap's step 4).
+ *
+ * DMA_GET: the nv2a-ack loop sets it to PUT once a segment has been walked
+ * (xbox_memory_layout.c). The GPU moves it as it goes, and D3D reads it
+ * while the GPU works: how far a fence is from the GPU is what decides
+ * whether a wait spins or sleeps until an interrupt (XDK D3D's BlockOnTime,
+ * Burnout 3 sub_00351770). So at the stream's sync points -- a semaphore
+ * release, a software method -- the walk's position is published as GET.
+ * Inside a pushbuffer subroutine GET is where the GPU is, as on hardware;
+ * D3D falls back to its fence table for an address outside the ring.
+ *
+ * Release: everything before this point has been read. */
+#define NV2A_REGS_VA        0xFD000000u
+#define NV2A_USER_DMA_GET   0x800044u
+#define NV2A_PGRAPH_PATT_COLOR0 0x400B10u
+extern uint32_t nv2a_pb_walk_va(int *in_call);
+static uint32_t s_progress_gets;
+
+/* RECOMP_GPU_PROGRESS: off by default while the executor still finishes
+ * each segment before the title may kick the next (then GET = PUT at the
+ * segment's end says all there is to say). On, the title sees the GPU's
+ * position sooner, which changes when its push-buffer waits wake and so
+ * the timing of a frame (the roadmap's step 4 frame check: the same race,
+ * render-time effects a few frames apart). It is for a GPU that runs
+ * behind the title (step 5), and on by default with RECOMP_RUN_AHEAD.
+ * =1: GET and PATT_COLOR0; =get, =patt: one; =0 off even with run-ahead. */
+enum { PROGRESS_GET = 1, PROGRESS_PATT = 2 };
+static int progress_mode(void)
+{
+    static int m = -1;
+    if (m < 0) {
+        const char *e = getenv("RECOMP_GPU_PROGRESS");
+        const char *ra = getenv("RECOMP_RUN_AHEAD");
+        if ((!e || !*e) && ra && *ra && *ra != '0')
+            e = "1";                    /* run-ahead needs it */
+        m = !e || !*e || !strcmp(e, "0") ? 0
+          : !strcmp(e, "get")  ? PROGRESS_GET
+          : !strcmp(e, "patt") ? PROGRESS_PATT
+          : PROGRESS_GET | PROGRESS_PATT;
+        if (m)
+            fprintf(stderr, "  [GPU] RECOMP_GPU_PROGRESS: %s%s\n",
+                    m & PROGRESS_GET ? "DMA_GET at sync points " : "",
+                    m & PROGRESS_PATT ? "PATT_COLOR0 at fences" : "");
+    }
+    return m;
+}
+
+static volatile uint32_t *nv2a_reg(uint32_t off)
+{
+    return (volatile uint32_t *)((uint8_t *)xbox_GetMemoryOffset()
+                                 + NV2A_REGS_VA + off);
+}
+
+static void gpu_progress(void)
+{
+    uint32_t va = nv2a_pb_walk_va(NULL), get;
+    volatile uint32_t *g;
+
+    if (!va || !(progress_mode() & PROGRESS_GET))
+        return;
+    get = va & 0x0FFFFFFFu;            /* GET is physical, like PUT */
+    g = nv2a_reg(NV2A_USER_DMA_GET);
+    __atomic_thread_fence(__ATOMIC_RELEASE);
+    if (*g != get) {
+        *g = get;
+        s_progress_gets++;
+        xbox_SpinWake();               /* a lowered wait may be sleeping on it */
+    }
+}
+
+/* The walk's position as GET every 64 words (nv2a_pb_scan.c), with
+ * RECOMP_GPU_PROGRESS's GET on. Between sync points too: BlockOnTime
+ * decides from GET whether the GPU is 9 KB or more from a fence, and if so
+ * writes its NOP 5 over the fence's padding and sleeps until the GPU gets
+ * there. A GET last moved at a sync point long before could say "far" of a
+ * walker already reading that padding, and the NOP would be missed: within
+ * 64 words (256 bytes and some inline data), it cannot. Outside a
+ * subroutine only (D3D's ring); no wake-up, as nothing waits on GET short
+ * of PUT, which the ack loop's segment end sets and wakes. */
+void nv2a_pb_walk_progress(void)
+{
+    int in_call;
+    uint32_t va;
+
+    if (!(progress_mode() & PROGRESS_GET))
+        return;
+    va = nv2a_pb_walk_va(&in_call);
+    if (va && !in_call)
+        *nv2a_reg(NV2A_USER_DMA_GET) = va & 0x0FFFFFFFu;
+}
+
+/* The semaphore release's target (BACK_END_WRITE_SEMAPHORE_RELEASE): the
+ * registered fence word plus the offset, else dma_resolve's guess. */
+static uint32_t sema_target(uint32_t offset)
+{
+    static int on = -1, said = -1;
+    uint32_t fw = 0, va;
+
+    if (on < 0) {
+        const char *e = getenv("RECOMP_SEMA_BASE");
+        on = !(e && *e == '0');
+    }
+    if (on)
+        fw = xbox_Nv2aFenceWordVa();
+    va = fw ? (XBOX_CONTIG_BASE | ((fw + offset) & 0x0FFFFFFFu)) : dma_resolve(offset);
+    if (said != (fw != 0)) {
+        said = fw != 0;
+        fprintf(stderr, "  [GPU] semaphore releases (offset 0x%08X) land at 0x%08X: %s\n",
+                offset, va, fw ? "the fence mirror's word (the DMA object's base)"
+                   : on ? "no fence mirror yet; DMA object assumed at 0"
+                        : "RECOMP_SEMA_BASE=0, DMA object assumed at 0");
+    }
+    return va;
+}
+
+/* Software methods: NO_OPERATION with a non-zero parameter.
+ *
+ * XDK D3D uses the NOP as a software method. On the console the GPU stops on
+ * it and raises PGRAPH's interrupt (xemu: NV_PGRAPH_INTR_ERROR, NSOURCE
+ * notification, the method and parameter trapped), and D3D's handler
+ * (Burnout 3: sub_00357000 -> sub_00357250, the low five bits of the
+ * parameter picking one of 14 cases) does the work. Case 1 is the swap,
+ * scheduled by flip_pacing_swap below. Case 5 is the one a GPU that runs
+ * behind the title needs: BlockOnTime, waiting on a fence the GPU is far
+ * from, writes a WAIT_FOR_IDLE and a NOP 5 over the fence's padding and
+ * sleeps on an event that the handler sets.
+ *
+ * The interrupt itself is not raised: PGRAPH_INTR is write-1-to-clear, and
+ * against plain memory D3D's acknowledgement writes the pending bit back, so
+ * its service loop (sub_00356BF0) would see it pending for ever. Instead the
+ * handler's work is done here, on the executor's thread, as the swap's is:
+ * the title registers what its D3D's cases do (nv2a_pb_set_swmethod_handler),
+ * since where D3D keeps the event is the title's build of D3D. A case with
+ * no handler is counted and said once; on the console it would have been
+ * handled, so a title that relies on one says so here. */
+static nv2a_swmethod_fn s_swm_fn;
+static uint32_t s_swm_seen[32], s_swm_handled[32];
+
+void nv2a_pb_set_swmethod_handler(nv2a_swmethod_fn fn)
+{
+    s_swm_fn = fn;
+}
+
+void nv2a_pb_swmethod_counts(uint32_t seen[32], uint32_t handled[32])
+{
+    memcpy(seen, s_swm_seen, sizeof s_swm_seen);
+    memcpy(handled, s_swm_handled, sizeof s_swm_handled);
+}
+
+uint32_t nv2a_pb_progress_gets(void) { return s_progress_gets; }
+
+static void flip_pacing_swap(uint32_t param);
+
+static void software_method(uint32_t subch, uint32_t param)
+{
+    uint32_t sw = param & 0x1Fu, n;
+    int done;
+
+    gpu_progress();                    /* the GPU stops here: GET says so */
+    if (sw == 1) {
+        flip_pacing_swap(param);
+        s_swm_seen[1]++;
+        s_swm_handled[1]++;
+        return;
+    }
+    done = s_swm_fn ? s_swm_fn(subch, param) : 0;
+    n = ++s_swm_seen[sw];
+    if (done)
+        s_swm_handled[sw]++;
+    /* Said the first time, then at each power of two. */
+    if ((n & (n - 1)) == 0)
+        fprintf(stderr, "  [GPU] software method %u (NOP 0x%08X) at flip %u:"
+                " %s, %u so far\n", sw, param, s_gpu.flips,
+                done ? "handled" : "NO HANDLER", n);
+}
