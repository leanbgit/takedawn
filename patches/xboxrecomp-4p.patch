diff --git a/tools/recomp/relocate.py b/tools/recomp/relocate.py
new file mode 100644
index 0000000..445c801
--- /dev/null
+++ b/tools/recomp/relocate.py
@@ -0,0 +1,144 @@
+"""Lift-time relocation of fixed guest data (``--relocate FILE``).
+
+A title keeps some arrays at fixed addresses in its BSS, sized for what it
+shipped with (Burnout 3: two players). Growing one in place is impossible:
+the next global follows it directly. Every access the code makes goes
+through a constant, though -- the array's base, a field of a fixed slot, or
+a base plus an index -- so the lift can move the whole array: each
+immediate and each memory displacement inside ``[lo, hi)`` becomes
+``to + (value - lo)``. Code that indexes past the old end then lands in the
+new, larger block instead of the neighbour's memory.
+
+The block at ``to`` must be guest memory nothing else uses; the runtime
+gives a title such a block right after its image (``g_xbox_image_extra``,
+xbox_memory_layout.c), so the address is fixed before the title runs.
+
+FILE is JSON::
+
+    {"relocations": [
+        {"lo": "0x0073A1D0", "hi": "0x0073F190", "to": "0x00780000",
+         "note": "..."}
+    ]}
+
+``hi`` is exclusive. An entry may also give ``"base"``: the address of a
+fixed object the array lives in, which code also reaches as a register plus
+an offset (``[esi + 0x12B7D0]`` with esi = the object). A memory
+displacement in ``[lo - base, hi - base)`` whose address has a base register
+is then rewritten to ``disp + (to - lo)`` as well. Never an immediate: such
+offsets are small enough to be code addresses too. Never a jmp/call
+operand (jump tables).
+
+``"size"`` (optional) is the size of the block at ``to`` when it is larger
+than the old array: a ``cmp`` against the old end (``hi``, a loop's
+sentinel: ``cmp esi, 0x73F190 / jl``) is then rewritten to ``to + size``, so
+a loop over every slot covers the new ones. Ranges must not overlap, and neither may the targets.
+Only operands are rewritten: data words in the image that hold such an
+address are not (check there are none before relying on this). Branch and
+call targets are code addresses and never fall in a data range.
+
+Every rewrite is counted by range and, when a report path is given, listed
+(instruction, operand kind, old, new) so a change in the lift is auditable.
+"""
+
+import json
+
+# (lo, hi, to, name) tuples, set by load(); empty means no rewriting at all,
+# which keeps the output byte-for-byte what it was without the option.
+_RANGES = []
+_SIZES = {}
+_COUNTS = {}
+_SITES = []
+
+
+def _int(v):
+    return int(v, 0) if isinstance(v, str) else int(v)
+
+
+def load(path):
+    """Read the relocation list; raise ValueError on overlapping ranges."""
+    global _RANGES
+    with open(path, "r", encoding="utf-8") as f:
+        doc = json.load(f)
+    rng = []
+    _SIZES.clear()
+    for i, r in enumerate(doc.get("relocations", [])):
+        lo, hi, to = _int(r["lo"]), _int(r["hi"]), _int(r["to"])
+        if not lo < hi:
+            raise ValueError(f"relocation {i}: lo must be below hi")
+        base = _int(r["base"]) if "base" in r else None
+        size = _int(r["size"]) if "size" in r else hi - lo
+        if size < hi - lo:
+            raise ValueError(f"relocation {i}: size below hi - lo")
+        _SIZES[r.get("name") or f"r{i}"] = size
+        rng.append((lo, hi, to, r.get("name") or f"r{i}", base))
+    rng.sort()
+    for a, b in zip(rng, rng[1:]):
+        if a[1] > b[0]:
+            raise ValueError(f"relocations {a[3]} and {b[3]} overlap")
+    tg = sorted((to, to + _SIZES[n], n) for lo, hi, to, n, _b in rng)
+    for a, b in zip(tg, tg[1:]):
+        if a[1] > b[0]:
+            raise ValueError(f"relocation targets {a[2]} and {b[2]} overlap")
+    _RANGES = rng
+    _COUNTS.clear()
+    _SITES.clear()
+    return len(rng)
+
+
+def active():
+    return bool(_RANGES)
+
+
+def _hit(name, insn_addr, kind, old, new):
+    _COUNTS[name] = _COUNTS.get(name, 0) + 1
+    if insn_addr is not None:
+        _SITES.append((insn_addr, kind, old, new, name))
+    return new
+
+
+def remap(value, insn_addr=None, kind="imm"):
+    """The relocated address for ``value``, or ``value`` itself."""
+    if not _RANGES or value is None or value < 0:
+        return value
+    for lo, hi, to, name, _base in _RANGES:
+        if lo <= value < hi:
+            return _hit(name, insn_addr, kind, value, to + (value - lo))
+    return value
+
+
+def remap_rel(disp, insn_addr=None):
+    """A displacement off a register: rewritten only for entries with a
+    ``base`` whose object-relative range holds it."""
+    if not _RANGES or disp is None or disp < 0:
+        return disp
+    for lo, hi, to, name, base in _RANGES:
+        if base is not None and lo - base <= disp < hi - base:
+            return _hit(name, insn_addr, "rel", disp, disp + (to - lo))
+    return disp
+
+
+def remap_end(value, insn_addr=None):
+    """A compared constant equal to an array's old end: the new end."""
+    if not _RANGES or value is None:
+        return value
+    for lo, hi, to, name, _base in _RANGES:
+        if value == hi:
+            return _hit(name, insn_addr, "end", value, to + _SIZES[name])
+    return value
+
+
+def summary():
+    return dict(_COUNTS)
+
+
+def write_report(path):
+    """One line a rewrite: the instruction, the operand kind, old -> new."""
+    seen = set()
+    with open(path, "w", encoding="utf-8") as f:
+        for addr, kind, old, new, name in sorted(_SITES):
+            key = (addr, kind, old)
+            if key in seen:      # an instruction decoded twice (two bodies)
+                continue
+            seen.add(key)
+            f.write(f"0x{addr:08X} {kind:4} 0x{old:08X} -> 0x{new:08X} {name}\n")
+    return len(seen)
diff --git a/tools/recomp/test_relocate.py b/tools/recomp/test_relocate.py
new file mode 100644
index 0000000..1bc4dee
--- /dev/null
+++ b/tools/recomp/test_relocate.py
@@ -0,0 +1,87 @@
+"""Tests for lift-time relocation (relocate.py, --relocate)."""
+
+import json
+import os
+import tempfile
+import unittest
+
+from capstone import Cs, CS_ARCH_X86, CS_MODE_32
+
+from . import relocate
+from .disasm import Disassembler
+
+
+def _cfg(entries):
+    fd, path = tempfile.mkstemp(suffix=".json")
+    with os.fdopen(fd, "w") as f:
+        json.dump({"relocations": entries}, f)
+    return path
+
+
+def _ops(code, addr=0x1000):
+    d = Disassembler()
+    cs = Cs(CS_ARCH_X86, CS_MODE_32)
+    cs.detail = True
+    insn = next(cs.disasm(code, addr))
+    return d._decode_instruction(insn).operands
+
+
+HUMANS = {"name": "humans", "lo": "0x0073A1D0", "hi": "0x0073F190",
+          "to": "0x00780000", "size": "0x9F80", "base": "0x0060EA00"}
+
+
+class RelocateTest(unittest.TestCase):
+    def tearDown(self):
+        relocate._RANGES = []
+        relocate._SIZES.clear()
+
+    def load(self, entries):
+        path = _cfg(entries)
+        try:
+            return relocate.load(path)
+        finally:
+            os.unlink(path)
+
+    def test_off_is_identity(self):
+        # mov eax, 0x73a1d0
+        self.assertEqual(_ops(bytes.fromhex("b8d0a17300"))[1].imm, 0x73A1D0)
+
+    def test_immediate_and_slot_field(self):
+        self.load([HUMANS])
+        self.assertEqual(_ops(bytes.fromhex("b8d0a17300"))[1].imm, 0x780000)
+        # mov eax, 0x73c9b0 (slot 1)
+        self.assertEqual(_ops(bytes.fromhex("b8b0c97300"))[1].imm, 0x7827E0)
+
+    def test_absolute_displacement(self):
+        self.load([HUMANS])
+        # mov eax, dword ptr [0x73a1d0 + 0x10dc]
+        op = _ops(bytes.fromhex("a1acb27300"))[1]
+        self.assertEqual(op.mem_disp, 0x780000 + 0x10DC)
+
+    def test_object_relative_displacement(self):
+        self.load([HUMANS])
+        # mov dword ptr [esi + 0x12b7d0], 0x3b11a0
+        op = _ops(bytes.fromhex("c786d0b71200a0113b00"))[0]
+        self.assertEqual(op.mem_base, "esi")
+        self.assertEqual(op.mem_disp, 0x780000 - 0x60EA00)
+
+    def test_object_relative_never_an_immediate(self):
+        self.load([HUMANS])
+        # push 0x12b7d0 stays: such a value is also a code address
+        self.assertEqual(_ops(bytes.fromhex("68d0b71200"))[0].imm, 0x12B7D0)
+
+    def test_loop_end_grows(self):
+        self.load([HUMANS])
+        # cmp esi, 0x73f190
+        self.assertEqual(_ops(bytes.fromhex("81fe90f17300"))[1].imm, 0x789F80)
+        # mov esi, 0x73f190 (the next array's base) stays
+        self.assertEqual(_ops(bytes.fromhex("be90f17300"))[1].imm, 0x73F190)
+
+    def test_overlap_rejected(self):
+        with self.assertRaises(ValueError):
+            self.load([HUMANS, dict(HUMANS, name="b", lo="0x0073A1E0",
+                                    hi="0x0073A1F0", to="0x00800000")])
+
+
+if __name__ == "__main__":
+    unittest.main()
