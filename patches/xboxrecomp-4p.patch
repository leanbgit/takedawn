+/* KeSetEvent from a host thread: a guest KEVENT signalled on the title's
+ * behalf by the runtime, which stands in for hardware whose interrupt
+ * handler would have set it (nv2a_pb_exec.c: the GPU's software methods).
+ * The same as the guest's own KeSetEvent, without its stack frame or the
+ * wake trace's caller. Returns 1 when an event was set. */
+/* An event the runtime sets this way may be re-armed by the title the way
+ * hardware lets it: by writing 0 into its SignalState in memory, with no
+ * kernel call (XDK D3D's BlockOnTime, Burnout 3 0x00351820, before it puts
+ * its NOP 5 in the push buffer). The host event behind it would stay set,
+ * and the next wait on it would return at once, before the GPU got there
+ * (roadmap step 5: the menu movie's push buffer reused while the walker
+ * still had it to read). So a wait on one of these events first resets the
+ * host event when the guest's SignalState says 0 -- under the same lock the
+ * setter takes around "SignalState = 1; SetEvent", so a set that lands
+ * between the check and the reset cannot be lost. */
+#define KE_HOST_SET_MAX 8
+static uint32_t s_host_set_va[KE_HOST_SET_MAX];
+static int s_host_set_n;
+static CRITICAL_SECTION s_host_set_cs;
+static volatile LONG s_host_set_init;
+
+static void host_set_lock(void)
+{
+    if (InterlockedCompareExchange(&s_host_set_init, 1, 0) == 0) {
+        InitializeCriticalSection(&s_host_set_cs);
+        InterlockedExchange(&s_host_set_init, 2);
+    }
+    while (s_host_set_init != 2)
+        Sleep(0);
+    EnterCriticalSection(&s_host_set_cs);
+}
+
+static int host_set_known(uint32_t guest_va)
+{
+    int n = s_host_set_n;
+    for (int i = 0; i < n; i++)
+        if (s_host_set_va[i] == guest_va)
+            return 1;
+    return 0;
+}
+
+int xbox_KeSetEventHost(uint32_t guest_va)
+{
+    HANDLE h;
+    int ok;
+
+    if (!guest_va || !bridge_va_mapped(guest_va, 16) || BRIDGE_MEM8(guest_va) > 1)
+        return 0;                       /* not a KEVENT */
+    h = ke_event_shadow(guest_va);
+    if (!h)
+        return 0;
+    host_set_lock();
+    if (!host_set_known(guest_va) && s_host_set_n < KE_HOST_SET_MAX)
+        s_host_set_va[s_host_set_n++] = guest_va;
+    ke_event_mirror(guest_va, h, 1);   /* (the wake trace is guest threads') */
+    ok = SetEvent(h) ? 1 : 0;
+    LeaveCriticalSection(&s_host_set_cs);
+    return ok;
+}
+
+/* Before a wait: re-armed in memory means re-armed (above). */
+static void host_set_rearm(uint32_t guest_va, HANDLE h)
+{
+    static unsigned rearms;
+    if (!s_host_set_n || !host_set_known(guest_va))
+        return;
+    host_set_lock();
+    if (BRIDGE_MEM32(guest_va + 4) == 0 && WaitForSingleObject(h, 0) == WAIT_OBJECT_0) {
+        ResetEvent(h);
+        if (rearms++ < 4)
+            fprintf(stderr, "  [KERNEL] KEVENT 0x%08X re-armed in memory by the title:"
+                    " stale host signal cleared before its wait (%u so far)\n",
+                    guest_va, rearms);
+    }
+    LeaveCriticalSection(&s_host_set_cs);
+}
